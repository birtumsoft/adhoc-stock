<odoo>
    <record id="view_picking_form_inherit_stock_voucher" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.stock.voucher</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <group name="other_infos" position="after">
                <group string="Remito electrónico (COT)">
                    <field name="cot"/>
                    <field name="cot_numero_unico"/>
                    <field name="cot_numero_comprobante"/>
                </group>
            </group>
            <field name="origin" position="after">
                <field name="dispatch_number"/>
            </field>
        </field>
    </record>
</odoo>
