<odoo>
    <!-- stock.book -->
    <record id="view_stock_book_tree" model="ir.ui.view">
        <field name="name">stock.book.list</field>
        <field name="model">stock.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sequence_id"/>
                <field name="lines_per_voucher"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_stock_book_form" model="ir.ui.view">
        <field name="name">stock.book.form</field>
        <field name="model">stock.book</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence_id"/>
                        <field name="lines_per_voucher"/>
                        <field name="next_number"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="l10n_ar_document_type_id"
                            invisible="country_code != 'AR' or code != 'outgoing'"/>
                        <field name="l10n_ar_cai_authorization_code"
                            invisible="not l10n_ar_document_type_id"
                            required="l10n_ar_document_type_id"/>
                        <field name="l10n_ar_cai_expiration_date"
                            invisible="not l10n_ar_document_type_id"
                            required="l10n_ar_document_type_id"/>
                        <field name="l10n_ar_delivery_sequence_prefix"
                            invisible="not l10n_ar_document_type_id"
                            required="l10n_ar_document_type_id"/>
                        <field name="l10n_ar_next_delivery_number"
                            invisible="not l10n_ar_document_type_id"
                            required="l10n_ar_document_type_id"/>
                        <field name="l10n_ar_sequence_number_start"
                            placeholder="00000001"
                            invisible="not l10n_ar_document_type_id"
                            required="l10n_ar_document_type_id"/>
                        <field name="l10n_ar_sequence_number_end"
                            placeholder="00000999"
                            invisible="not l10n_ar_document_type_id"
                            required="l10n_ar_document_type_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_book_actions" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">stock.book</field>
        <field name="path">books</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem name="Books" id="menu_books" sequence="20" action="stock_book_actions" parent="stock.menu_warehouse_config" />
</odoo>
