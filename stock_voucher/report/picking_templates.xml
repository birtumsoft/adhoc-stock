<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!--               REPORTE PDF DE ETIQUETA DE REMITO          -->
    <!-- ========================================================= -->
    <template id="custom_label_transfer_template_view_pdf">
        <t t-foreach="docs" t-as="o">
            <div class="page">

                <!-- HEADER -->
                <div class="row">
                    <div class="col-6">
                        <strong>Customer:</strong>
                        <span t-field="o.partner_id.commercial_partner_id.name"/>
                        <br/>
                        <strong>VAT Cond:</strong>
                        <span t-field="o.partner_id.l10n_ar_afip_responsibility_type_id"/>
                        <br/>
                        <t t-if="o.partner_id.vat">
                            <strong>CUIT:</strong>
                            <span t-field="o.partner_id.l10n_ar_formatted_vat"/>
                        </t>
                    </div>

                    <div class="col-6 text-right">
                        <strong>Order:</strong>
                        <span t-field="o.origin"/>
                        <t t-if="o.cot">
                            <br/>
                            <strong>COT:</strong>
                            <span t-field="o.cot"/>
                        </t>
                        <t t-if="o.purchase_order_number">
                            <br/>
                            <strong>PO Number:</strong>
                            <span t-field="o.purchase_order_number"/>
                        </t>
                    </div>
                </div>

                <!-- TABLE OF LINES -->
                <table class="table table-sm mt16">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>UOM</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.move_lines" t-as="line">
                            <tr>
                                <td><span t-field="line.product_id.display_name"/></td>
                                <td><span t-field="line.product_uom_qty"/></td>
                                <td><span t-field="line.product_uom_id.name"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- SIGNATURE SECTION -->
                <t t-if="o.picking_type_id.report_signature_section">
                    <div class="row mt32">
                        <div class="col-6 text-center">
                            Recibí conforme:
                            <hr style="border:1px solid #000"/>
                        </div>
                        <div class="col-6 text-center">
                            Firma / Aclaración:
                            <hr style="border:1px solid #000"/>
                        </div>
                    </div>
                </t>

                <!-- BARCODE SECTION -->
                <t t-if="o.l10n_ar_afip_barcode">
                    <div style="text-align:center; margin-top:16px;">
                        <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=400&amp;height=40' % o.l10n_ar_afip_barcode"/>
                        <br/>
                        <span t-esc="o.l10n_ar_afip_barcode"/>
                    </div>
                </t>

            </div>
        </t>
    </template>

    <!-- ========================================================= -->
    <!--               REPORTE ZPL DE ETIQUETA DE REMITO          -->
    <!-- ========================================================= -->
    <template id="custom_label_transfer_template_view_zpl">
        <t t-foreach="docs" t-as="o">
            <t t-set="lines" t-value="o.move_lines"/>
            <t t-foreach="lines" t-as="line">
^XA
^FO50,50^A0N,30,30^FDProduct: <t t-esc='line.product_id.display_name'/>^FS
^FO50,100^A0N,30,30^FDQty: <t t-esc='line.product_uom_qty'/> <t t-esc='line.product_uom_id.name'/>^FS

<t t-if="o.cot">
^FO50,150^A0N,30,30^FDCOT: <t t-esc='o.cot'/>^FS
</t>

<t t-if="o.picking_type_id.report_signature_section">
^FO50,200^A0N,30,30^FDRecibí conforme:^FS
^FO50,250^GB400,1,3^FS
^FO50,300^A0N,30,30^FDFirma / Aclaración:^FS
^FO50,350^GB400,1,3^FS
</t>

^XZ
            </t>
        </t>
    </template>

</odoo>
