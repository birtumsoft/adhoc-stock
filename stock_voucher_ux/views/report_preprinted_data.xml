<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORMATO DE PAPEL PERSONALIZADO -->
    <record id="paperformat_deliveryslip_a4_recibo" model="report.paperformat">
        <field name="name">A4 Recibo de Entrega</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">48</field>      
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">52</field>
        <field name="dpi">90</field>
    </record>
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="paperformat_id" ref="stock_voucher_ux.paperformat_deliveryslip_a4_recibo"/>
    </record>

</odoo>