<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_delivery_document" priority="20" inherit_id="stock_ux.report_delivery_document">
        <xpath expr="//p[@t-if='o.observations']" position="after">
            <div style="margin-top: 20px;">
                <t t-if="o.picking_type_id.code == 'outgoing' and o.carrier_id">
                    <strong>Se despacha por:</strong>
                    <span t-field="o.carrier_id"/>
                    <t t-if="o.carrier_id.partner_id.vat">
                        (
                        <span t-field="o.carrier_id.partner_id.l10n_latam_identification_type_id"/>:
                        <span t-field="o.carrier_id.partner_id.vat"/>
                        )
                    </t>
                    <div style="margin-top: 6px;">
                        <span t-field="o.carrier_id.partner_id"
                              t-options="{
                                'widget': 'contact',
                                'fields': ['address'],
                                'no_marker': True,
                                'no_tag_br': True
                              }"/>
                    </div>
                </t>
            </div>
        </xpath>
    </data>
</odoo>
